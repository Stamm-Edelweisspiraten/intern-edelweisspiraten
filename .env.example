# --- Datenbank -------------------------------------------------------------
# Die Anwendung laeuft auf PostgreSQL 15 oder neuer. Fuer die Entwicklung
# genuegt der Container aus docker-compose.yml:
#   docker compose up -d postgres
#   npm run db:migrate
#
# Die Verbindung wird in dieser Reihenfolge ermittelt -- die erste Quelle,
# die vollstaendig ist, gewinnt:
#
#   1. DATABASE_URL
#   2. die einzelnen DB_*-Variablen (mindestens DB_HOST und DB_NAME)
#   3. die Datei, die der Einrichtungsassistent unter /setup anlegt
#      (Pfad ueber DB_CONFIG_FILE, Vorgabe ./data/database.json)
#   4. keine -- die Anwendung startet, jeder Datenbankzugriff scheitert dann
#      mit einer verstaendlichen Meldung
DATABASE_URL=postgres://intern:intern@localhost:5432/intern

# Alternative zu DATABASE_URL. Wird nur ausgewertet, wenn DATABASE_URL leer
# ist. Sonderzeichen in Passwort, Benutzername und Datenbanknamen werden
# beim Zusammenbau kodiert -- ein @ oder / im Passwort ist hier also
# unproblematisch, anders als in DATABASE_URL.
# DB_TYPE=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=application
# DB_USER=application
# DB_PASSWORD=
# DB_SSL=false

# Ablage der im Einrichtungsassistenten erfassten Verbindung. Die Datei
# enthaelt Zugangsdaten und gehoert nicht ins Repository.
# DB_CONFIG_FILE=./data/database.json

# Groesse des Verbindungspools; die Voreinstellung reicht fuer einen Stamm.
# DATABASE_POOL_MAX=10

# --- Sicherheit ------------------------------------------------------------
# Beide je 32 Byte, base64: openssl rand -base64 32
SESSION_SECRET=
# Verschluesselt Geheimnisse in der Datenbank: TOTP-Secrets und den
# geheimen Schluessel des Objektspeichers.
#
# Der Name MFA_ENC_KEY bleibt aus Gruenden der Abwaertskompatibilitaet
# gueltig; APP_ENC_KEY hat Vorrang. Wird der Schluessel gewechselt, sind alle
# damit verschluesselten Werte unlesbar -- Zwei-Faktor muss dann neu
# eingerichtet und der Speicherschluessel neu hinterlegt werden.
APP_ENC_KEY=
# MFA_ENC_KEY=

# Basis-Adresse fuer Links in E-Mails (Passwort zuruecksetzen, Einladungen),
# im Einladungs-PDF und im Export der Einladungslinks. Ohne die Angabe gilt
# der Ursprung der jeweiligen Anfrage.
PUBLIC_APP_URL=http://localhost:5173

# Oeffentliche Adresse der Anwendung im PRODUKTIONSBETRIEB (node build).
#
# adapter-node prueft bei jedem Formular-POST, ob die Origin-Kopfzeile zur
# Adresse passt (Schutz vor CSRF). Ohne ORIGIN raet es aus den Kopfzeilen der
# Anfrage -- hinter einem Reverse Proxy mit HTTPS liegt es damit falsch und
# weist JEDEN POST mit 403 ab, die Anmeldung eingeschlossen.
#
# Muss mit PUBLIC_APP_URL uebereinstimmen. Fuer npm run dev irrelevant.
ORIGIN=http://localhost:3000

# --- Ersteinrichtung / Notzugang -------------------------------------------
# Normalerweise wird der erste Zugang ueber /setup angelegt; dort werden auch
# Name des Stamms, Kontenrahmen und wahlweise Demodaten eingerichtet. Diese
# Variablen sind der Wiederherstellungsweg, falls man sich ausgesperrt hat:
# beim Start wird der Zugang angelegt bzw. repariert. Danach wieder entfernen.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FORCE=1

# --- E-Mail ----------------------------------------------------------------
# SMTP laesst sich seit Neuestem auch im Adminbereich einstellen, unter
# /intern/admin/email. Die Reihenfolge ist dieselbe wie beim Objektspeicher:
#
#   1. diese Umgebungsvariablen -- sind SMTP_HOST und SMTP_FROM gesetzt,
#      gewinnen sie vollstaendig und die Adminseite zeigt die Werte nur an
#   2. die Einstellung im Adminbereich (in der Datenbank, Passwort
#      verschluesselt mit APP_ENC_KEY)
#   3. Vorgaben: Port 587, STARTTLS, Absendername aus den
#      Organisationseinstellungen
#
# So bleibt ein Betrieb ganz ohne Geheimnisse in der Datenbank moeglich.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Absendername, erscheint vor der Adresse: "Stamm Edelweiss" <post@...>
# SMTP_FROM_NAME=
# Antwortadresse, falls sie von der Absenderadresse abweicht.
# SMTP_REPLY_TO=
# none | starttls | tls. Ohne Angabe wird aus dem Port abgeleitet:
# 465 bedeutet tls, alles andere starttls.
# SMTP_ENCRYPTION=starttls

# --- REST-API --------------------------------------------------------------
# Kommagetrennte Herkuenfte, die die API aus einem Browser aufrufen duerfen.
# Ohne Angabe ist der Zugriff aus fremden Seiten gesperrt; Server-zu-Server-
# Aufrufe mit Token sind davon nicht betroffen.
# API_CORS_ORIGINS=https://beispiel.de

# --- Uploads ---------------------------------------------------------------
# Obergrenze des Anfragekoerpers im Produktionsbetrieb (node build).
#
# adapter-node nimmt ohne diese Angabe 512K an. Die Oberflaeche laesst
# dagegen 10 MB je Datei zu, und jeder groessere Upload scheiterte mit 413,
# bevor Anwendungscode ueberhaupt lief. Der Wert muss ueber MAX_FILE_BYTES
# aus src/lib/server/fileStore.ts liegen; 12M laesst Raum fuer den
# Mehraufwand der multipart-Kodierung.
#
# Fuer npm run dev ist die Angabe wirkungslos -- dort greift der Adapter nicht.
BODY_SIZE_LIMIT=12M

# --- Betrieb hinter einem Reverse Proxy ------------------------------------
# Ohne diese Angaben sieht die Anwendung nur die IP des Proxys, wodurch die
# Begrenzung der Anmeldeversuche pro IP wirkungslos waere.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# --- Objektspeicher: Garage ------------------------------------------------
# Die docker-compose.yml bringt Garage samt Bedienoberflaeche mit. Beide
# Geheimnisse sind PFLICHT, sobald die Dienste starten sollen -- ohne sie
# verweigert Compose den Start mit einem Hinweis.
#
#   openssl rand -hex 32      -> GARAGE_RPC_SECRET   (genau 64 Zeichen)
#   openssl rand -base64 32   -> GARAGE_ADMIN_TOKEN
#
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Denselben Bucket benutzen ALLE Dateien: Mitgliedsunterlagen, Belege der
# Kasse, Dokumente, das Logo, die Titelbilder der Termine und die Galerie.
# Es gibt bewusst keinen zweiten Bucket und keine zweiten Zugangsdaten --
# getrennt wird ueber den Schluessel (siehe S3_PREFIX), nicht ueber den Bucket.
#
# Danach einmalig:
#   docker compose up -d
#   npm run storage:setup
#
# Das legt Bucket und Zugangsschluessel an und hinterlegt sie unter
# /intern/admin/speicher. Der Lauf ist wiederholbar.
#
# Bedienoberflaeche von Garage: http://localhost:3909

# --- Objektspeicher: Zugangsdaten ueber die Umgebung ------------------------
# Optional und meist unnoetig -- `npm run storage:setup` hinterlegt alles im
# Adminbereich. Diese Variablen haben VORRANG vor dieser Einstellung; die
# Seite zeigt die Werte dann nur noch an.
#
# Zwei Faelle, in denen sie gebraucht werden:
#
#   1. Containerbetrieb (docker compose --profile app). Im Container heisst
#      der Dienst "garage", nicht "localhost" -- der Endpunkt steht deshalb
#      schon in der docker-compose.yml, das Schluesselpaar gehoert hierher.
#      `npm run storage:setup` gibt am Ende die passenden Zeilen aus.
#   2. Ein fremder Anbieter statt Garage, dessen Zugangsdaten nicht in der
#      Datenbank stehen sollen.
#
# S3_ENDPOINT=http://garage:3900
# S3_REGION=garage
# S3_BUCKET=portal
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Trennt mehrere Installationen in einem gemeinsamen Bucket.
# S3_PREFIX=stamm-edelweiss/
# Pfad-Adressierung: noetig fuer Garage, MinIO und die meisten
# selbstgehosteten Speicher, bei AWS S3 selbst auf false setzen.
# S3_FORCE_PATH_STYLE=true
