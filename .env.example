# --- Datenbank -------------------------------------------------------------
# Ein Single-Node-Replica-Set genuegt und ermoeglicht Transaktionen:
#   docker run -d --name ep-mongo -p 27017:27017 mongo:7 --replSet rs0
#   docker exec ep-mongo mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=intern-dev

# --- Sicherheit ------------------------------------------------------------
# Beide je 32 Byte, base64: openssl rand -base64 32
SESSION_SECRET=
# Verschluesselt die TOTP-Secrets in der Datenbank.
MFA_ENC_KEY=

# Basis-Adresse fuer Links in E-Mails (Passwort zuruecksetzen, Einladungen)
# und im Einladungs-PDF.
PUBLIC_APP_URL=http://localhost:5173

# --- Ersteinrichtung / Notzugang -------------------------------------------
# Normalerweise wird der erste Zugang ueber /setup angelegt. Diese Variablen
# sind der Wiederherstellungsweg, falls man sich ausgesperrt hat: beim Start
# wird der Zugang angelegt bzw. repariert. Danach wieder entfernen.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FORCE=1

# --- E-Mail ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Betrieb hinter einem Reverse Proxy ------------------------------------
# Ohne diese Angaben sieht die Anwendung nur die IP des Proxys, wodurch die
# Begrenzung der Anmeldeversuche pro IP wirkungslos waere.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
